# Copy to .env in the repository root. All values are read by the backend.
IML_MODE=demo
IML_HOST=127.0.0.1
IML_PORT=8000
# Live mode: choose a provider's OpenAI-compatible /v1 URL and model IDs.
IML_API_BASE_URL=
IML_API_KEY=
IML_CHEAP_MODEL=
IML_STRONG_MODEL=
# Optional provider prices, USD per million tokens. Blank means unknown.
IML_CHEAP_INPUT_PRICE=
IML_CHEAP_OUTPUT_PRICE=
IML_STRONG_INPUT_PRICE=
IML_STRONG_OUTPUT_PRICE=
# Reference tokenizer for text comparison; provider usage wins for billing.
IML_ENCODING=cl100k_base
IML_CACHE_THRESHOLD=0.88
# Learned cache entries expire after 30 days and the SQLite cache is LRU-bounded.
IML_CACHE_TTL_SECONDS=2592000
IML_CACHE_MAX_ENTRIES=10000
IML_CACHE_SEMANTIC_THRESHOLD=0.55
# Optional Redis/Valkey exact-match hot index. SQLite remains the durable source.
IML_CACHE_REDIS_URL=
